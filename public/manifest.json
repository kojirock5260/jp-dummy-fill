{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "1.0.0",
  "minimum_chrome_version": "114",
  "default_locale": "en",
  "description": "__MSG_appDesc__",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "jp-dummy-fill"
  },
  "commands": {
    "fill": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "__MSG_cmdFill__"
    },
    "place": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "__MSG_cmdPlace__"
    },
    "pick": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "__MSG_cmdPick__"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
